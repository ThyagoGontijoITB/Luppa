SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# SQL Server - local development defaults may use localhost.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=luppaBD
DB_USERNAME=luppa_app
DB_PASSWORD=change-me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Use a random 32+ byte value. Example generator:
# openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=120

FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173
LUPPA_TERMS_URL=http://localhost:5173/terms
LUPPA_PRIVACY_URL=http://localhost:5173/privacy

IMAGE_STORAGE_DIR=uploads/events
IMAGE_PUBLIC_BASE_URL=http://localhost:8081/uploads/events
PROFILE_IMAGE_STORAGE_DIR=uploads/profile
PROFILE_IMAGE_PUBLIC_BASE_URL=http://localhost:8081/uploads/profile

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
LUPPA_EMAIL_FROM=no-reply@example.com
LUPPA_SUPPORT_EMAIL=support@example.com
LUPPA_EMAIL_LOGO_URL=

RATE_LIMIT_ENABLED=true
# Comma-separated trusted reverse proxy IPv4 CIDR ranges. Leave blank unless the app is behind a known proxy.
TRUSTED_PROXY_CIDRS=

GEOCODING_PROVIDER=none
GEOCODING_BASE_URL=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Luppa Admin
ADMIN_PHONE=11999999999
ADMIN_DATE_OF_BIRTH=1990-01-01

# Production must set SPRING_PROFILES_ACTIVE=prod and must override all public URLs with HTTPS URLs.
# Production SQL Server TLS must keep encrypt=true and trustServerCertificate=false.
